// Cloudflare Workers Builds (Git-Anbindung): Jeder Push auf main veröffentlicht die Website.
// Veröffentlicht wird nur der Ordner src/. .github, data, tools und alles im Hauptordner bleiben privat.
// Der Name muss gleich dem Worker in Cloudflare sein.
{
  "name": "siebtraeger-guide-github",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./src",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
